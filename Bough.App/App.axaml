<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bough.App.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="PathIcon.boughIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button PathIcon.boughIcon">
      <Setter Property="Foreground" Value="{ReflectionBinding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="MenuItem PathIcon.boughIcon">
      <Setter Property="Foreground" Value="{ReflectionBinding $parent[MenuItem].Foreground}" />
    </Style>
    <Style Selector="PathIcon.boughChevronIcon">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource BoughBrushCanvas}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource BoughBrushRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Button:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushSelectionText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorderStrong}" />
    </Style>
    <Style Selector="Button:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorderStrong}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccentText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccentText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushFocus}" />
    </Style>
    <Style Selector="Button.primary:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccentText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource BoughBrushErrorSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushError}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushError}" />
    </Style>
    <Style Selector="Button.danger:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushError}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushError}" />
    </Style>
    <Style Selector="Button.danger:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushErrorSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushError}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="Button.danger:disabled">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
    </Style>
    <Style Selector="Button.danger:focus-visible:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushFocus}" />
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushFocus}" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushTextMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource BoughBrushRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccent}" />
    </Style>
    <Style Selector="TabItem:disabled">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource BoughBrushInput}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="TextBox:pointerover:not(:disabled)">
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorderStrong}" />
    </Style>
    <Style Selector="TextBox:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushFocus}" />
    </Style>
    <Style Selector="TextBox:disabled">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource BoughBrushInput}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="ComboBox:pointerover:not(:disabled)">
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorderStrong}" />
    </Style>
    <Style Selector="ComboBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushFocus}" />
    </Style>
    <Style Selector="ComboBox:disabled">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="MenuItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushSelectionText}" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource BoughBrushRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
    </Style>
    <Style Selector="TextBlock.boughError">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushError}" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Assets/ActionIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Light">
        <Color x:Key="BoughColorHeader">#E8EFF6</Color>
        <SolidColorBrush x:Key="BoughBrushHeader" Color="#E8EFF6" />
        <Color x:Key="BoughColorSubheader">#F0F4F8</Color>
        <SolidColorBrush x:Key="BoughBrushSubheader" Color="#F0F4F8" />
        <Color x:Key="BoughColorSidebar">#F2F5F9</Color>
        <SolidColorBrush x:Key="BoughBrushSidebar" Color="#F2F5F9" />
        <Color x:Key="BoughColorCanvas">#F7F9FC</Color>
        <SolidColorBrush x:Key="BoughBrushCanvas" Color="#F7F9FC" />
        <Color x:Key="BoughColorSurface">#FFFFFF</Color>
        <SolidColorBrush x:Key="BoughBrushSurface" Color="#FFFFFF" />
        <Color x:Key="BoughColorRaised">#EEF3F8</Color>
        <SolidColorBrush x:Key="BoughBrushRaised" Color="#EEF3F8" />
        <Color x:Key="BoughColorInset">#F3F6FA</Color>
        <SolidColorBrush x:Key="BoughBrushInset" Color="#F3F6FA" />
        <Color x:Key="BoughColorInput">#FFFFFF</Color>
        <SolidColorBrush x:Key="BoughBrushInput" Color="#FFFFFF" />
        <Color x:Key="BoughColorBorder">#D5DFEA</Color>
        <SolidColorBrush x:Key="BoughBrushBorder" Color="#D5DFEA" />
        <Color x:Key="BoughColorBorderStrong">#A5B6C9</Color>
        <SolidColorBrush x:Key="BoughBrushBorderStrong" Color="#A5B6C9" />
        <Color x:Key="BoughColorText">#22364A</Color>
        <SolidColorBrush x:Key="BoughBrushText" Color="#22364A" />
        <Color x:Key="BoughColorTextMuted">#4C6176</Color>
        <SolidColorBrush x:Key="BoughBrushTextMuted" Color="#4C6176" />
        <Color x:Key="BoughColorTextSubtle">#5D7084</Color>
        <SolidColorBrush x:Key="BoughBrushTextSubtle" Color="#5D7084" />
        <Color x:Key="BoughColorAccent">#326B9D</Color>
        <SolidColorBrush x:Key="BoughBrushAccent" Color="#326B9D" />
        <Color x:Key="BoughColorAccentText">#FFFFFF</Color>
        <SolidColorBrush x:Key="BoughBrushAccentText" Color="#FFFFFF" />
        <Color x:Key="BoughColorSelection">#E0ECF7</Color>
        <SolidColorBrush x:Key="BoughBrushSelection" Color="#E0ECF7" />
        <Color x:Key="BoughColorSelectionText">#244C70</Color>
        <SolidColorBrush x:Key="BoughBrushSelectionText" Color="#244C70" />
        <Color x:Key="BoughColorDisabled">#E9EEF4</Color>
        <SolidColorBrush x:Key="BoughBrushDisabled" Color="#E9EEF4" />
        <Color x:Key="BoughColorDisabledText">#718093</Color>
        <SolidColorBrush x:Key="BoughBrushDisabledText" Color="#718093" />
        <Color x:Key="BoughColorError">#A72F37</Color>
        <SolidColorBrush x:Key="BoughBrushError" Color="#A72F37" />
        <Color x:Key="BoughColorErrorSurface">#FDECEE</Color>
        <SolidColorBrush x:Key="BoughBrushErrorSurface" Color="#FDECEE" />
        <Color x:Key="BoughColorWarning">#8C5A08</Color>
        <SolidColorBrush x:Key="BoughBrushWarning" Color="#8C5A08" />
        <Color x:Key="BoughColorWarningSurface">#FFF4DB</Color>
        <SolidColorBrush x:Key="BoughBrushWarningSurface" Color="#FFF4DB" />
        <Color x:Key="BoughColorSuccess">#216642</Color>
        <SolidColorBrush x:Key="BoughBrushSuccess" Color="#216642" />
        <Color x:Key="BoughColorSuccessSurface">#E4F3E8</Color>
        <SolidColorBrush x:Key="BoughBrushSuccessSurface" Color="#E4F3E8" />
        <Color x:Key="BoughColorDiffAdded">#176D46</Color>
        <SolidColorBrush x:Key="BoughBrushDiffAdded" Color="#176D46" />
        <Color x:Key="BoughColorDiffAddedSurface">#E3F5E8</Color>
        <SolidColorBrush x:Key="BoughBrushDiffAddedSurface" Color="#E3F5E8" />
        <Color x:Key="BoughColorDiffRemoved">#AD3940</Color>
        <SolidColorBrush x:Key="BoughBrushDiffRemoved" Color="#AD3940" />
        <Color x:Key="BoughColorDiffRemovedSurface">#FDE9E9</Color>
        <SolidColorBrush x:Key="BoughBrushDiffRemovedSurface" Color="#FDE9E9" />
        <Color x:Key="BoughColorDiffHunk">#4B5D9C</Color>
        <SolidColorBrush x:Key="BoughBrushDiffHunk" Color="#4B5D9C" />
        <Color x:Key="BoughColorDiffHunkSurface">#E8ECFA</Color>
        <SolidColorBrush x:Key="BoughBrushDiffHunkSurface" Color="#E8ECFA" />
        <Color x:Key="BoughColorFocus">#2A6DAD</Color>
        <SolidColorBrush x:Key="BoughBrushFocus" Color="#2A6DAD" />
        <Color x:Key="BoughColorGraphOne">#136D90</Color>
        <SolidColorBrush x:Key="BoughBrushGraphOne" Color="#136D90" />
        <Color x:Key="BoughColorGraphTwo">#9B4C8B</Color>
        <SolidColorBrush x:Key="BoughBrushGraphTwo" Color="#9B4C8B" />
        <Color x:Key="BoughColorGraphThree">#B26F18</Color>
        <SolidColorBrush x:Key="BoughBrushGraphThree" Color="#B26F18" />
        <Color x:Key="BoughColorGraphFour">#498043</Color>
        <SolidColorBrush x:Key="BoughBrushGraphFour" Color="#498043" />
        <Color x:Key="BoughColorGraphFive">#B84343</Color>
        <SolidColorBrush x:Key="BoughBrushGraphFive" Color="#B84343" />
        <Color x:Key="BoughColorGraphSix">#4E65A8</Color>
        <SolidColorBrush x:Key="BoughBrushGraphSix" Color="#4E65A8" />
        <Color x:Key="BoughColorGraphSeven">#7B5AA6</Color>
        <SolidColorBrush x:Key="BoughBrushGraphSeven" Color="#7B5AA6" />
        <Color x:Key="BoughColorGraphEight">#2D8777</Color>
        <SolidColorBrush x:Key="BoughBrushGraphEight" Color="#2D8777" />
      </ResourceDictionary>
      <ResourceDictionary x:Key="Dark">
        <Color x:Key="BoughColorHeader">#202C3B</Color>
        <SolidColorBrush x:Key="BoughBrushHeader" Color="#202C3B" />
        <Color x:Key="BoughColorSubheader">#1A2533</Color>
        <SolidColorBrush x:Key="BoughBrushSubheader" Color="#1A2533" />
        <Color x:Key="BoughColorSidebar">#192432</Color>
        <SolidColorBrush x:Key="BoughBrushSidebar" Color="#192432" />
        <Color x:Key="BoughColorCanvas">#141E2A</Color>
        <SolidColorBrush x:Key="BoughBrushCanvas" Color="#141E2A" />
