        <SolidColorBrush x:Key="BoughBrushInput" Color="#202F40" />
        <Color x:Key="BoughColorBorder">#34465A</Color>
        <SolidColorBrush x:Key="BoughBrushBorder" Color="#34465A" />
        <Color x:Key="BoughColorBorderStrong">#526A84</Color>
        <SolidColorBrush x:Key="BoughBrushBorderStrong" Color="#526A84" />
