        <SolidColorBrush x:Key="BoughBrushText" Color="#E6EDF5" />
        <Color x:Key="BoughColorTextMuted">#B1C0D1</Color>
        <SolidColorBrush x:Key="BoughBrushTextMuted" Color="#B1C0D1" />
        <Color x:Key="BoughColorTextSubtle">#94A8BE</Color>
        <SolidColorBrush x:Key="BoughBrushTextSubtle" Color="#94A8BE" />
        <Color x:Key="BoughColorAccent">#94C2F0</Color>
        <SolidColorBrush x:Key="BoughBrushAccent" Color="#94C2F0" />
        <Color x:Key="BoughColorAccentText">#12263A</Color>
        <SolidColorBrush x:Key="BoughBrushAccentText" Color="#12263A" />
        <Color x:Key="BoughColorSelection">#2B455F</Color>
        <SolidColorBrush x:Key="BoughBrushSelection" Color="#2B455F" />
        <Color x:Key="BoughColorSelectionText">#ECF4FC</Color>
        <SolidColorBrush x:Key="BoughBrushSelectionText" Color="#ECF4FC" />
        <Color x:Key="BoughColorDisabled">#263445</Color>
        <SolidColorBrush x:Key="BoughBrushDisabled" Color="#263445" />
        <Color x:Key="BoughColorDisabledText">#8698AC</Color>
        <SolidColorBrush x:Key="BoughBrushDisabledText" Color="#8698AC" />
        <Color x:Key="BoughColorError">#EEA7A7</Color>
        <SolidColorBrush x:Key="BoughBrushError" Color="#EEA7A7" />
        <Color x:Key="BoughColorErrorSurface">#44272B</Color>
        <SolidColorBrush x:Key="BoughBrushErrorSurface" Color="#44272B" />
        <Color x:Key="BoughColorWarning">#E7C073</Color>
        <SolidColorBrush x:Key="BoughBrushWarning" Color="#E7C073" />
        <Color x:Key="BoughColorWarningSurface">#4A3A21</Color>
        <SolidColorBrush x:Key="BoughBrushWarningSurface" Color="#4A3A21" />
        <Color x:Key="BoughColorSuccess">#8DD5A0</Color>
        <SolidColorBrush x:Key="BoughBrushSuccess" Color="#8DD5A0" />
        <Color x:Key="BoughColorSuccessSurface">#1D3B2A</Color>
        <SolidColorBrush x:Key="BoughBrushSuccessSurface" Color="#1D3B2A" />
        <Color x:Key="BoughColorDiffAdded">#77D5B5</Color>
        <SolidColorBrush x:Key="BoughBrushDiffAdded" Color="#77D5B5" />
        <Color x:Key="BoughColorDiffAddedSurface">#173A2D</Color>
        <SolidColorBrush x:Key="BoughBrushDiffAddedSurface" Color="#173A2D" />
        <Color x:Key="BoughColorDiffRemoved">#F0A1A7</Color>
        <SolidColorBrush x:Key="BoughBrushDiffRemoved" Color="#F0A1A7" />
        <Color x:Key="BoughColorDiffRemovedSurface">#44292D</Color>
        <SolidColorBrush x:Key="BoughBrushDiffRemovedSurface" Color="#44292D" />
