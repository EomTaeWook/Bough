<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- MainWindow is constructed through DI and is not loaded by XAML URI. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>Bough</AssemblyName>
    <AssemblyTitle>Bough</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(PublishSingleFile)' == 'true'">
    <AssemblyMetadata Include="BoughPublishedSingleFile" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\AppIcon.ico" />
    <AvaloniaResource Include="Assets\AppIcon.png" />
    <ProjectReference Include="..\Bough.Core\Bough.Core.csproj">
      <AdditionalProperties Condition="'$(Configuration)' == 'Release'">DebugType=embedded;CopyOutputSymbolsToPublishDirectory=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\DataContainer\DataContainer.csproj">
      <AdditionalProperties Condition="'$(Configuration)' == 'Release'">DebugType=embedded;CopyOutputSymbolsToPublishDirectory=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="DignusLog.config">
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Release'">PreserveNewest</CopyToOutputDirectory>
      <CopyToOutputDirectory Condition="'$(Configuration)' == 'Release'">Never</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'$(Configuration)' == 'Release'">Never</CopyToPublishDirectory>
    </None>
    <Content Include="..\Datas\*.json" Link="Datas\%(Filename)%(Extension)">
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Release'">PreserveNewest</CopyToOutputDirectory>
      <CopyToOutputDirectory Condition="'$(Configuration)' == 'Release'">Never</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'$(Configuration)' == 'Release'">Never</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="..\Datas\*.json" LogicalName="Bough.Datas.%(Filename)%(Extension)" />
    <EmbeddedResource Include="DignusLog.config" LogicalName="Bough.DignusLog.config" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="Bough.Licenses.Bough.txt" />
    <EmbeddedResource Include="$(NuGetPackageRoot)dignus\1.3.0\LICENSE" LogicalName="Bough.Licenses.Dignus.txt"
                      Condition="Exists('$(NuGetPackageRoot)dignus\1.3.0\LICENSE')" />
    <EmbeddedResource Include="$(NuGetPackageRoot)dignus.log\1.0.13\LICENSE" LogicalName="Bough.Licenses.Dignus.Log.txt"
                      Condition="Exists('$(NuGetPackageRoot)dignus.log\1.0.13\LICENSE')" />
    <EmbeddedResource Include="Assets\Licenses\*.txt" LogicalName="Bough.Licenses.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
