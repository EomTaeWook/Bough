<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bough.App.ViewModels"
        xmlns:models="using:Bough.App.ViewModels.Models"
        xmlns:views="using:Bough.App.Views"
        x:Class="Bough.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Bough"
        Icon="/Assets/AppIcon.ico"
        Width="1440"
        Height="920"
        MinWidth="1080"
        MinHeight="700"
        Background="{DynamicResource BoughBrushCanvas}">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource BoughBrushRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccentText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ours">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDiffAddedSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushDiffAdded}" />
    </Style>
    <Style Selector="Button.theirs">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDiffHunkSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushDiffHunk}" />
    </Style>
    <Style Selector="Button.navigation">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.navigation.active">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Menlo, monospace" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource BoughBrushInset}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource BoughBrushHeader}" BorderBrush="{DynamicResource BoughBrushBorderStrong}" BorderThickness="0,0,0,1">
      <Grid RowDefinitions="72,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Image Width="34" Height="34" Source="/Assets/AppIcon.png" />
          <TextBlock Text="Bough" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center" Margin="18,0">
          <Button x:Name="RepositoryPickerButton" Grid.Column="0" Classes="navigation"
                  Height="48" MinWidth="140" Padding="12,4" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Focusable="True"
                  AutomationProperties.Name="{Binding RepositoryName}"
                  ToolTip.Tip="{Binding RepositoryList.RepositoriesHeadingText}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <PathIcon Grid.Column="0" Data="{StaticResource BoughIconFolder}" Classes="boughIcon" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding RepositoryName}" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding RepositoryMeta}" IsVisible="{Binding HasRepository}"
                           Foreground="{DynamicResource BoughBrushTextMuted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RepositoryMeta}" />
              </StackPanel>
              <PathIcon Grid.Column="2" Data="{StaticResource BoughIconChevronDown}" Classes="boughIcon boughChevronIcon" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel x:Name="RepositoryPickerPanel" Width="360" Spacing="8">
                  <StackPanel.Styles>
                    <Style Selector="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
                    </Style>
                    <Style Selector="Button.repository">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="CornerRadius" Value="5" />
                      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
                      <Setter Property="Padding" Value="12,6" />
                    </Style>
                    <Style Selector="Button.repository:pointerover /template/ ContentPresenter">
                      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
                    </Style>
                    <Style Selector="Button.repository.active">
                      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
                      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccent}" />
                    </Style>
                    <Style Selector="Border.repositoryRow">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="CornerRadius" Value="5" />
                    </Style>
                    <Style Selector="Border.repositoryRow.active">
                      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
                    </Style>
                    <Style Selector="Button.repositoryRemove">
                      <Setter Property="Opacity" Value="0" />
                      <Setter Property="Width" Value="26" />
                      <Setter Property="Height" Value="26" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="FontSize" Value="16" />
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Foreground" Value="{DynamicResource BoughBrushTextSubtle}" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="Border.repositoryRow:pointerover Button.repositoryRemove">
                      <Setter Property="Opacity" Value="1" />
                    </Style>
                    <Style Selector="Border.repositoryRow:focus-within Button.repositoryRemove">
                      <Setter Property="Opacity" Value="1" />
                    </Style>
                    <Style Selector="Button.repositoryRemove:focus">
                      <Setter Property="Opacity" Value="1" />
                    </Style>
                  </StackPanel.Styles>
                  <TextBlock Text="{Binding RepositoryList.RepositoriesHeadingText}" FontSize="16"
                             FontWeight="SemiBold" Margin="12,4,0,0" />
                  <ScrollViewer x:Name="RepositoryListScrollViewer" MaxHeight="400"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RepositoryList.RepositoryGroups}" Margin="0,0,36,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RepositoryGroup">
                            <ItemsControl ItemsSource="{Binding Repositories}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RepositoryItem">
                                  <Border Classes="repositoryRow" Classes.active="{Binding IsActive}">
                                    <Grid ColumnDefinitions="*,26" MinHeight="32">
                                      <Button Grid.Column="0" Classes="repository" Classes.active="{Binding IsActive}"
                                              HorizontalAlignment="Stretch" Click="RepositoryClicked"
                                              ToolTip.Tip="{Binding RootPath}" ToolTip.Placement="TopEdgeAlignedRight"
                                              ToolTip.ShowDelay="1000" ToolTip.BetweenShowDelay="-1"
                                              AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding RootPath}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                          <PathIcon Grid.Column="0" Data="{StaticResource BoughIconFolder}" Classes="boughIcon" />
                                          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                     Foreground="{ReflectionBinding $parent[Button].Foreground}" />
                                        </Grid>
                                      </Button>
                                      <Button Grid.Column="1" Classes="repositoryRemove" Click="RemoveRepositoryClicked"
                                              ToolTip.Tip="{ReflectionBinding $parent[ScrollViewer].DataContext.RepositoryList.RemoveFromListTooltipText}"
                                              AutomationProperties.Name="{ReflectionBinding $parent[ScrollViewer].DataContext.RepositoryList.RemoveFromListTooltipText}">
                                        <PathIcon Data="{StaticResource BoughIconClose}" Classes="boughIcon" Width="12" Height="12" />
                                      </Button>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="RepositoryActionsButton" Grid.Column="1" Classes="navigation toolbar"
                  Width="32" Padding="0" Focusable="True" Click="RepositoryActionsClicked">
            <PathIcon Data="{StaticResource BoughIconAdd}" Classes="boughIcon" />
            <Button.ContextMenu>
              <ContextMenu MinWidth="240" Placement="BottomEdgeAlignedLeft">
                <MenuItem x:Name="OpenRepositoryMenuItem" Click="OpenRepositoryClicked">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource BoughIconOpenFolder}" Classes="boughIcon" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CloneRepositoryMenuItem" Click="CloneRepositoryClicked">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource BoughIconClone}" Classes="boughIcon" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Button Command="{Binding ShowLocalChangesCommand}" Classes="navigation toolbar"
                  AutomationProperties.Name="{Binding LocalChangesNavigationText}" Classes.active="{Binding IsLocalChangesView}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource BoughIconChanges}" Classes="boughIcon" />
              <TextBlock Text="{Binding LocalChangesNavigationText}" FontSize="14" VerticalAlignment="Center"
                         Foreground="{ReflectionBinding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ShowHistoryCommand}" Classes="navigation toolbar"
                  AutomationProperties.Name="{Binding HistoryNavigationText}" Classes.active="{Binding IsHistoryView}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource BoughIconHistory}" Classes="boughIcon" />
              <TextBlock Text="{Binding HistoryNavigationText}" FontSize="14" VerticalAlignment="Center"
                         Foreground="{ReflectionBinding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ShowGitSettingsCommand}" Classes="navigation toolbar"
                  AutomationProperties.Name="{Binding SettingsNavigationText}" Classes.active="{Binding IsGitSettingsView}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource BoughIconSettings}" Classes="boughIcon" />
              <TextBlock Text="{Binding SettingsNavigationText}" FontSize="14" VerticalAlignment="Center"
                         Foreground="{ReflectionBinding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Border Width="1" Background="{DynamicResource BoughBrushBorder}" Margin="5,9" />
          <Button IsEnabled="{Binding HasRepository}" Focusable="True" ToolTip.Tip="{Binding OpenFolderToolTipText}"
                  AutomationProperties.Name="{Binding OpenFolderAutomationName}" Classes="navigation toolbar" Click="OpenFolderClicked">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource BoughIconOpenExternal}" Classes="boughIcon" />
              <TextBlock Text="{Binding OpenInText}" FontSize="14" VerticalAlignment="Center"
                         Foreground="{ReflectionBinding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding References.OpenTerminalCommand}" Focusable="True"
                  ToolTip.Tip="{Binding ConsoleToolTipText}"
                  AutomationProperties.Name="{Binding ConsoleAutomationName}" Classes="navigation toolbar">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource BoughIconTerminal}" Classes="boughIcon" />
              <TextBlock Text="{Binding ConsoleText}" FontSize="14" VerticalAlignment="Center"
                         Foreground="{ReflectionBinding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource BoughBrushSubheader}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="0,1,0,0">
        <Grid>
          <views:RemoteOperationsView x:Name="RemoteOperationsPanel" DataContext="{Binding RemoteOperations}" />
          <ProgressBar IsVisible="{Binding IsRemoteLoading}" IsIndeterminate="True"
                       Height="3" VerticalAlignment="Bottom" />
        </Grid>
      </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="280,*">
      <Border Grid.Column="0" Background="{DynamicResource BoughBrushSidebar}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto" Margin="12">
          <Border Grid.Row="0" IsVisible="{Binding HasRepository}">
            <Grid>
              <views:ReferenceExplorerView DataContext="{Binding References}" />
              <ProgressBar IsVisible="{Binding IsReferencesLoading}" IsIndeterminate="True"
                           Height="3" VerticalAlignment="Top" />
            </Grid>
          </Border>
          <Border Grid.Row="1" IsVisible="{Binding HasSidebarStatus}"
                  Background="{DynamicResource BoughBrushSidebar}" BorderBrush="{DynamicResource BoughBrushBorder}"
                  BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Spacing="8">
              <ScrollViewer IsVisible="{Binding HasSidebarStatusText}" MaxHeight="112"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding SidebarStatusText}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource BoughBrushTextMuted}"
                           ToolTip.Tip="{Binding SidebarStatusText}" />
              </ScrollViewer>
              <ProgressBar IsVisible="{Binding IsMainProgress}" IsIndeterminate="True" Height="3" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border Grid.Row="0" IsVisible="{Binding IsRebaseInProgress}"
                Background="{DynamicResource BoughBrushWarningSurface}"
                BorderBrush="{DynamicResource BoughBrushBorderStrong}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,8" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="{Binding RebaseProgressLabel}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BoughBrushText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding RebaseStatusText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource BoughBrushTextMuted}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="primary" Content="{Binding ContinueRebaseText}"
                    Command="{Binding ContinueRebaseCommand}" VerticalAlignment="Center" Height="32" Padding="12,4" />
          </Grid>
        </Border>

        <Border Grid.Row="1" IsVisible="{Binding IsHistoryView}">
          <views:HistoryView DataContext="{Binding History}" />
        </Border>
        <Border Grid.Row="1" IsVisible="{Binding IsLocalChangesView}">
          <Grid>
            <views:LocalChangesView x:Name="LocalChangesPanel" DataContext="{Binding LocalChanges}" />
            <ProgressBar IsVisible="{Binding IsLocalChangesLoading}" IsIndeterminate="True"
                         Height="3" VerticalAlignment="Top" />
          </Grid>
        </Border>
        <Border Grid.Row="1" IsVisible="{Binding IsStashView}">
          <views:StashView DataContext="{Binding LocalChanges.Stashes}" />
        </Border>
        <Border Grid.Row="1" IsVisible="{Binding IsGitSettingsView}">
          <views:GitSettingsView x:Name="GitSettingsPanel" DataContext="{Binding GitSettings}" />
        </Border>
        <Border Grid.Row="1" IsVisible="{Binding IsRepositoryStartView}"
                Background="{DynamicResource BoughBrushCanvas}" Padding="32">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" MaxWidth="480">
            <Image Source="/Assets/AppIcon.png" Width="72" Height="72" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding RepositoryName}" FontSize="24" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <Button x:Name="OpenRepositoryButton" Click="OpenRepositoryClicked" Classes="primary"
                      MinHeight="32" Padding="16,8" Focusable="True">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource BoughIconOpenFolder}" Classes="boughIcon" />
                  <TextBlock x:Name="OpenRepositoryActionLabel" VerticalAlignment="Center"
                             Foreground="{ReflectionBinding $parent[Button].Foreground}" />
                </StackPanel>
              </Button>
              <Button x:Name="CloneRepositoryButton" Click="CloneRepositoryClicked"
                      MinHeight="32" Padding="16,8" Focusable="True">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource BoughIconClone}" Classes="boughIcon" />
                  <TextBlock x:Name="CloneRepositoryActionLabel" VerticalAlignment="Center"
                             Foreground="{ReflectionBinding $parent[Button].Foreground}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

  </Grid>
</Window>
