<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bough.App.ViewModels"
        x:Class="Bough.App.ConflictWindow" x:DataType="vm:ConflictResolutionViewModel"
        Title="{Binding WindowTitle}" Width="1360" Height="850" MinWidth="980" MinHeight="650" Background="{DynamicResource BoughBrushCanvas}">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource BoughBrushRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushBorder}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccentText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ours">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDiffAddedSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushDiffAdded}" />
    </Style>
    <Style Selector="Button.theirs">
      <Setter Property="Background" Value="{DynamicResource BoughBrushDiffHunkSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushDiffHunk}" />
    </Style>
    <Style Selector="Button.repository">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.repository.active">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccent}" />
    </Style>
    <Style Selector="Button.navigation">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushTextMuted}" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.navigation.active">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccent}" />
    </Style>
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Menlo, monospace" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource BoughBrushInset}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="*,36">
    <Grid Grid.Row="0" ColumnDefinitions="280,*">
      <Border Grid.Column="0" Background="{DynamicResource BoughBrushInset}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="0,0,1,0">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Margin="6,8,6,14" Spacing="5">
            <TextBlock Text="{Binding FilesToResolveText}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ConflictCountText}" Foreground="{DynamicResource BoughBrushTextSubtle}" FontSize="12" />
          </StackPanel>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding ConflictFiles}"
                   SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConflictFileItem">
                <Grid Margin="12,10" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Row="0" Text="{Binding FileName}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="1" Text="{Binding DirectoryName}" Foreground="{DynamicResource BoughBrushTextSubtle}"
                             FontSize="11" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="64,*,300">
        <Border Grid.Row="0" Background="{DynamicResource BoughBrushSurface}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="18,0">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding CurrentFilePath}" FontSize="15" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding CurrentHunkText}" Foreground="{DynamicResource BoughBrushTextSubtle}" FontSize="12" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding PreviousButtonText}" Command="{Binding PreviousHunkCommand}"
                    VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="{Binding NextButtonText}" Command="{Binding NextHunkCommand}"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="16,16,16,10">
          <Border Grid.Column="0" Background="{DynamicResource BoughBrushDiffAddedSurface}" BorderBrush="{DynamicResource BoughBrushDiffAdded}" BorderThickness="1"
                  CornerRadius="10" Margin="0,0,6,0">
            <Grid RowDefinitions="70,*">
              <Border Grid.Row="0" Background="{DynamicResource BoughBrushDiffAddedSurface}" CornerRadius="9,9,0,0" Padding="15,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding CurrentChangeLabel}" Foreground="{DynamicResource BoughBrushDiffAdded}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding OursSource}" Foreground="{DynamicResource BoughBrushTextMuted}" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <TextBox Grid.Row="1" Classes="code" Text="{Binding OursText}"
                       IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
          </Border>

          <Border Grid.Column="1" Background="{DynamicResource BoughBrushDiffHunkSurface}" BorderBrush="{DynamicResource BoughBrushDiffHunk}" BorderThickness="1"
                  CornerRadius="10" Margin="6,0,0,0">
            <Grid RowDefinitions="70,*">
              <Border Grid.Row="0" Background="{DynamicResource BoughBrushDiffHunkSurface}" CornerRadius="9,9,0,0" Padding="15,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding IncomingChangeLabel}" Foreground="{DynamicResource BoughBrushDiffHunk}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding TheirsSource}" Foreground="{DynamicResource BoughBrushDiffHunk}" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <TextBox Grid.Row="1" Classes="code" Text="{Binding TheirsText}"
                       IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="{DynamicResource BoughBrushRaised}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="1"
                CornerRadius="10" Padding="10" Margin="0,0,0,22">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Button Classes="ours" Content="{Binding UseCurrentChangeLabel}" Command="{Binding ChooseOursCommand}" />
            <Button Classes="theirs" Content="{Binding UseIncomingChangeLabel}" Command="{Binding ChooseTheirsCommand}" />
            <Button Content="{Binding UseBothLabel}" Command="{Binding ChooseBothCommand}" />
            <Button Content="{Binding RemoveBothLabel}" Command="{Binding RemoveBothCommand}" />
            <Border Width="1" Background="{DynamicResource BoughBrushBorder}" Margin="5,2" />
            <TextBlock Text="{Binding CurrentChoiceText}" Foreground="{DynamicResource BoughBrushTextMuted}"
                       VerticalAlignment="Center" Margin="4,0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BoughBrushInset}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="0,1,0,0">
          <Grid RowDefinitions="48,*" Margin="16,0,16,14">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding FinalFileText}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FinalFileHintText}"
                           Foreground="{DynamicResource BoughBrushTextSubtle}" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="1" Classes="primary" Content="{Binding SaveAndStageText}"
                      Command="{Binding SaveAndStageCommand}" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="1" CornerRadius="8">
              <TextBox Classes="code" Text="{Binding ResultText, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="NoWrap"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource BoughBrushSurface}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,180" Margin="16,0">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource BoughBrushTextMuted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding QueueStatusText}" IsVisible="{Binding HasQueueStatus}"
                   Foreground="{DynamicResource BoughBrushTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="12,0"
                   MaxWidth="300" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="2" IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
