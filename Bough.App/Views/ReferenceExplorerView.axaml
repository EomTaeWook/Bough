<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bough.App.ViewModels"
             xmlns:models="using:Bough.App.ViewModels.Models"
             x:Class="Bough.App.Views.ReferenceExplorerView"
             x:DataType="vm:ReferenceExplorerViewModel"
             Background="{DynamicResource BoughBrushSidebar}">
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="Button.referenceBranchAdd">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.referenceBranchAdd:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
    </Style>
    <Style Selector="Button.referenceBranchAdd:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccentText}" />
    </Style>
    <Style Selector="Button.referenceBranchAdd:disabled">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
    </Style>
    <Style Selector="Button.referenceBranchAdd:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushFocus}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource BoughBrushSurface}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
        <TextBlock Text="{Binding ReferenceTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushText}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReferenceTitle}" />
        <TextBlock Grid.Column="1" Text="·" FontSize="14" Foreground="{DynamicResource BoughBrushTextMuted}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding CurrentBranchDisplay}" FontSize="14" Foreground="{DynamicResource BoughBrushTextMuted}" MinWidth="0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentBranchDisplay}" />
      </Grid>
    </Border>

    <TreeView x:Name="ReferenceTree" Grid.Row="1" ItemsSource="{Binding TreeRoots}"
              SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
              KeyDown="TreeKeyDown" Margin="4,8,4,8"
              Background="{DynamicResource BoughBrushSidebar}" Foreground="{DynamicResource BoughBrushText}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              AutomationProperties.Name="{Binding ReferenceTreeAccessibleName}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem">
          <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="MinHeight" Value="32" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover, TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeViewItem:pressed /template/ Border#PART_LayoutRoot:pointerover, TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover, TreeViewItem:pressed:selected /template/ Border#PART_LayoutRoot:pointerover, TreeViewItem:disabled /template/ Border#PART_LayoutRoot, TreeViewItem:disabled:selected /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.referenceNodeRow">
          <Setter Property="Margin" Value="0,0,16,0" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.referenceNodeRow:pointerover:not(.referenceEmpty):not(.referenceSectionRow)">
          <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
        </Style>
        <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter Border.referenceNodeRow:not(.referenceEmpty):not(.referenceSectionRow)">
          <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
        </Style>
        <Style Selector="TreeViewItem:focus-visible /template/ Border#PART_LayoutRoot, TreeViewItem /template/ Border#PART_LayoutRoot:focus-visible">
          <Setter Property="BorderBrush" Value="{DynamicResource BoughBrushFocus}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.referenceSectionRow">
          <Setter Property="Margin" Value="0,8,16,0" />
        </Style>
        <Style Selector="TextBlock.referenceSection">
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
        </Style>
        <Style Selector="TextBlock.referenceCurrent">
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccent}" />
        </Style>
        <Style Selector="TextBlock.referenceEmpty">
          <Setter Property="Foreground" Value="{DynamicResource BoughBrushTextSubtle}" />
          <Setter Property="FontSize" Value="12" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="models:ReferenceTreeNode" ItemsSource="{Binding Children}">
          <Border Classes="referenceNodeRow" Classes.referenceSectionRow="{Binding IsSection}" Classes.referenceEmpty="{Binding IsEmpty}"
                  Padding="2,4,20,4" MinHeight="32" HorizontalAlignment="Stretch"
                  Tapped="TreeNodeTapped" DoubleTapped="TreeNodeDoubleTapped"
                  ToolTip.Tip="{Binding ToolTipText}"
                  AutomationProperties.Name="{Binding AccessibleLabel}">
            <Border.ContextMenu>
              <ContextMenu Tag="{Binding}" Placement="RightEdgeAlignedTop" Opened="TreeContextOpened" Closed="TreeContextClosed">
                <MenuItem Click="CreateBranchSectionClicked" />
                <MenuItem Click="CreateTagSectionClicked" />
                <MenuItem Click="OpenStashesClicked" />
                <MenuItem Click="SwitchMenuBranchClicked" />
                <MenuItem Click="CreateFromBranchClicked" />
                <MenuItem Click="TrackMenuRemoteClicked" />
                <MenuItem Click="OpenPullRequestClicked" />
                <MenuItem Click="RenameLocalBranchClicked" />
                <MenuItem Click="RenameLocalTagClicked" />
                <MenuItem Click="CopyTreeNameClicked" />
                <MenuItem Click="PushTagClicked" />
                <Separator />
                <MenuItem Click="DeleteLocalBranchClicked" />
                <MenuItem Click="DeleteRemoteBranchClicked" />
                <MenuItem Click="DeleteTagClicked" />
                <MenuItem Click="OpenSubmoduleClicked" />
              </ContextMenu>
            </Border.ContextMenu>
            <Grid ColumnDefinitions="20,*,Auto" MinWidth="0" MinHeight="24">
              <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BoughBrushTextMuted}" />
              <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14"
                         MinWidth="0" Margin="4,0,0,0" ToolTip.Tip="{Binding ToolTipText}"
                         Classes.referenceSection="{Binding IsSection}"
                         Classes.referenceCurrent="{Binding IsCurrent}"
                         Classes.referenceEmpty="{Binding IsEmpty}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource BoughIconCheck}" Classes="boughIcon"
                          IsVisible="{Binding IsCurrent}" Foreground="{DynamicResource BoughBrushAccent}"
                          Margin="4,0" ToolTip.Tip="{Binding CurrentBranchText}" />
                <Button Classes="referenceBranchAdd" Click="CreateSectionAddClicked"
                        Tapped="IgnoreTreeTap"
                        IsVisible="{Binding HasSectionAction}" Padding="3,0" MinWidth="24" MinHeight="24"
                        ToolTip.Tip="{Binding ActionText}" AutomationProperties.Name="{Binding ActionText}"
                        Focusable="True">
                  <PathIcon Data="{StaticResource BoughIconAdd}" Classes="boughIcon" Width="12" Height="12" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

  </Grid>
</UserControl>
