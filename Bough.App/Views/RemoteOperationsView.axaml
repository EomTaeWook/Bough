<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bough.App.ViewModels"
             x:Class="Bough.App.Views.RemoteOperationsView"
             x:DataType="vm:RemoteOperationsViewModel">
  <UserControl.Styles>
    <Style Selector="Button.remoteActionSegment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Button.remoteActionSegment:pointerover">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
    </Style>
    <Style Selector="Button.remoteActionSegment:pressed">
      <Setter Property="Background" Value="{DynamicResource BoughBrushBorderStrong}" />
    </Style>
    <Style Selector="Button.remoteActionSegment:disabled">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="18,5" RowSpacing="4">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
      <TextBlock x:Name="UpstreamLabel" Foreground="{DynamicResource BoughBrushTextSubtle}" />
      <TextBlock Text="{Binding UpstreamText}" Foreground="{DynamicResource BoughBrushTextMuted}"
                 MaxWidth="220" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding UpstreamText}" />
      <TextBlock Text="{Binding AheadBehindText}" IsVisible="{Binding HasUpstream}" Foreground="{DynamicResource BoughBrushTextMuted}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Border BorderBrush="{DynamicResource BoughBrushBorderStrong}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource BoughBrushRaised}" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,1,Auto">
          <Button x:Name="FetchButton" Grid.Column="0" Classes="remoteActionSegment" Click="FetchClicked"
                  IsEnabled="{Binding CanFetch}" Padding="12,3" />
          <Border Grid.Column="1" Background="{DynamicResource BoughBrushBorderStrong}" />
          <Button x:Name="FetchMenuButton" Grid.Column="2" Classes="remoteActionSegment" Content="▾" Click="FetchMenuClicked"
                  IsEnabled="{Binding CanFetchAll}" Padding="6,3" />
        </Grid>
      </Border>
      <Border BorderBrush="{DynamicResource BoughBrushBorderStrong}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource BoughBrushRaised}" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,1,Auto">
          <Button x:Name="PullButton" Grid.Column="0" Classes="remoteActionSegment" Click="PullClicked"
                  IsEnabled="{Binding CanPull}" Padding="12,3" />
          <Border Grid.Column="1" Background="{DynamicResource BoughBrushBorderStrong}" />
          <Button x:Name="PullMenuButton" Grid.Column="2" Classes="remoteActionSegment" Content="▾" Click="PullMenuClicked"
                  IsEnabled="{Binding CanPull}" Padding="6,3" />
        </Grid>
      </Border>
      <Border BorderBrush="{DynamicResource BoughBrushBorderStrong}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource BoughBrushRaised}" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,1,Auto">
          <Button x:Name="PushButton" Grid.Column="0" Classes="remoteActionSegment" Click="PushClicked"
                  IsEnabled="{Binding CanPush}" Padding="12,3"
                  ToolTip.Tip="{Binding PushAvailabilityText}" />
          <Border Grid.Column="1" Background="{DynamicResource BoughBrushBorderStrong}" />
          <Button x:Name="PushMenuButton" Grid.Column="2" Classes="remoteActionSegment" Content="▾" Click="PushMenuClicked"
                  IsEnabled="{Binding CanPushTo}" Padding="6,3" />
        </Grid>
      </Border>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource BoughBrushTextSubtle}" FontSize="10"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
      <TextBlock Grid.Column="1" Text="{Binding PushAvailabilityText}" IsVisible="{Binding HasNoOutgoingPushCommits}"
                 Foreground="{DynamicResource BoughBrushWarning}" FontSize="10" MaxWidth="260" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding PushAvailabilityText}" />
    </Grid>
  </Grid>
</UserControl>
