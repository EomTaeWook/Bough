<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bough.App.ViewModels"
             x:Class="Bough.App.Views.RemoteOperationsView"
             x:DataType="vm:RemoteOperationsViewModel">
  <UserControl.Styles>
    <Style Selector="Button.remoteActionSegment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Button.remoteActionSegment:pointerover">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
    </Style>
    <Style Selector="Button.remoteActionSegment:pressed">
      <Setter Property="Background" Value="{DynamicResource BoughBrushBorderStrong}" />
    </Style>
    <Style Selector="Button.remoteActionSegment:disabled">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushDisabledText}" />
    </Style>
    <Style Selector="TextBlock#OutgoingCommitsLabel">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="TextBlock#IncomingCommitsLabel">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushText}" />
    </Style>
    <Style Selector="TextBlock#OutgoingCommitsLabel.hasChanges">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccent}" />
    </Style>
    <Style Selector="TextBlock#IncomingCommitsLabel.hasChanges">
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushWarning}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto" Margin="16,8" RowSpacing="8">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
      <Border BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BoughBrushRaised}" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,1,Auto">
          <Button x:Name="FetchButton" Grid.Column="0" Classes="remoteActionSegment" Click="FetchClicked"
                  IsEnabled="{Binding CanFetch}" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource BoughIconFetch}" Classes="boughIcon" />
              <TextBlock x:Name="FetchActionLabel" VerticalAlignment="Center"
                         Foreground="{ReflectionBinding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Border Grid.Column="1" Background="{DynamicResource BoughBrushBorder}" />
          <Button x:Name="FetchMenuButton" Grid.Column="2" Classes="remoteActionSegment" Click="FetchMenuClicked"
                  IsEnabled="{Binding CanFetchAll}" Padding="8,4">
            <PathIcon Data="{StaticResource BoughIconChevronDown}" Classes="boughIcon boughChevronIcon" />
          </Button>
        </Grid>
      </Border>
      <Border BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BoughBrushRaised}" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,1,Auto">
          <Button x:Name="PullButton" Grid.Column="0" Classes="remoteActionSegment" Click="PullClicked"
                  IsEnabled="{Binding CanPull}" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource BoughIconPull}" Classes="boughIcon" />
              <TextBlock x:Name="PullActionLabel" VerticalAlignment="Center"
                         Foreground="{ReflectionBinding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Border Grid.Column="1" Background="{DynamicResource BoughBrushBorder}" />
          <Button x:Name="PullMenuButton" Grid.Column="2" Classes="remoteActionSegment" Click="PullMenuClicked"
                  IsEnabled="{Binding CanPull}" Padding="8,4">
            <PathIcon Data="{StaticResource BoughIconChevronDown}" Classes="boughIcon boughChevronIcon" />
          </Button>
        </Grid>
      </Border>
      <Border BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BoughBrushRaised}" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,1,Auto">
          <Button x:Name="PushButton" Grid.Column="0" Classes="remoteActionSegment" Click="PushClicked"
                  IsEnabled="{Binding CanPush}" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource BoughIconPush}" Classes="boughIcon" />
              <TextBlock x:Name="PushActionLabel" VerticalAlignment="Center"
                         Foreground="{ReflectionBinding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Border Grid.Column="1" Background="{DynamicResource BoughBrushBorder}" />
          <Button x:Name="PushMenuButton" Grid.Column="2" Classes="remoteActionSegment" Click="PushMenuClicked"
                  IsEnabled="{Binding CanPushTo}" Padding="8,4">
            <PathIcon Data="{StaticResource BoughIconChevronDown}" Classes="boughIcon boughChevronIcon" />
          </Button>
        </Grid>
      </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Right">
        <TextBlock x:Name="UpstreamLabel" FontSize="12" Foreground="{DynamicResource BoughBrushTextSubtle}" />
        <TextBlock Grid.Column="1" Text="{Binding UpstreamText}" FontSize="12" Foreground="{DynamicResource BoughBrushTextMuted}"
                   MaxWidth="220" TextTrimming="CharacterEllipsis" />
      </Grid>
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding HasUpstream}">
        <TextBlock x:Name="OutgoingCommitsLabel" Classes.hasChanges="{Binding HasOutgoingCommits}" Margin="0,0,8,0"
                   FontSize="14" FontWeight="SemiBold" />
        <TextBlock x:Name="IncomingCommitsLabel" Classes.hasChanges="{Binding HasIncomingCommits}"
                   FontSize="14" FontWeight="SemiBold" />
      </WrapPanel>
    </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource BoughBrushText}" FontSize="14"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="AutoFetchFailureLabel" IsVisible="{Binding HasAutoFetchError}"
                   Foreground="{DynamicResource BoughBrushWarning}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding PushAvailabilityText}" IsVisible="{Binding HasNoOutgoingPushCommits}"
                 Foreground="{DynamicResource BoughBrushWarning}" FontSize="12" MaxWidth="260" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</UserControl>
