<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:git="using:Bough.Core.Git.Models"
        x:Class="Bough.App.Views.IgnoreFilesWindow"
        Width="660" Height="560" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BoughBrushCanvas}">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccentText}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="*,Auto" Margin="16" RowSpacing="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12">
    <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushText}" TextWrapping="Wrap" />
    <StackPanel x:Name="DirectoryInputPanel" Spacing="8" IsVisible="False">
      <TextBlock x:Name="DirectoryPathLabel" Foreground="{DynamicResource BoughBrushText}" />
      <TextBox x:Name="DirectoryPathInput" TextChanged="DirectoryPathChanged" />
      <TextBlock x:Name="DirectoryPathHint" FontSize="12" Foreground="{DynamicResource BoughBrushTextMuted}" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock x:Name="Description" Foreground="{DynamicResource BoughBrushTextMuted}" TextWrapping="Wrap" />
    <ListBox x:Name="FilesList" MinHeight="96" MaxHeight="180" Background="{DynamicResource BoughBrushInset}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="1" CornerRadius="8">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="git:GitIgnoreEntry">
          <StackPanel Margin="12,6" Spacing="4">
            <TextBlock Text="{Binding Path}" Foreground="{DynamicResource BoughBrushText}" TextWrapping="Wrap" ToolTip.Tip="{Binding Path}" />
            <TextBlock Text="{Binding Rule}" FontSize="12" Foreground="{DynamicResource BoughBrushTextSubtle}" FontFamily="Cascadia Mono, Menlo, monospace" TextWrapping="Wrap" ToolTip.Tip="{Binding Rule}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="PreparationText" Foreground="{DynamicResource BoughBrushTextMuted}" TextWrapping="Wrap" IsVisible="False" />
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource BoughBrushError}" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Click="CancelClicked" IsCancel="True" />
      <Button x:Name="ConfirmButton" Click="ConfirmClicked" Classes="primary" />
    </StackPanel>
  </Grid>
</Window>
