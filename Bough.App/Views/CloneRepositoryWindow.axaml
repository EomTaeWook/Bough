<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Bough.App.Views.CloneRepositoryWindow"
        Width="600" MinWidth="480" Height="400" MinHeight="340"
        CanResize="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BoughBrushCanvas}">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16" Margin="12">
    <TextBlock x:Name="HeadingText" Grid.Row="0" FontSize="18" FontWeight="SemiBold"
               Foreground="{DynamicResource BoughBrushText}" />
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock x:Name="RemoteLabel" Foreground="{DynamicResource BoughBrushText}" />
      <TextBox x:Name="RemoteInput" />
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="8">
      <TextBlock x:Name="DestinationLabel" Foreground="{DynamicResource BoughBrushText}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="DestinationInput" Grid.Column="0" />
        <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseClicked" Height="32" MinWidth="80" Padding="12,4" />
      </Grid>
      <TextBlock x:Name="DestinationHint" Foreground="{DynamicResource BoughBrushTextMuted}"
                 TextWrapping="Wrap" FontSize="11" />
    </StackPanel>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource BoughBrushText}"
                   TextWrapping="Wrap" />
        <ProgressBar x:Name="CloneProgress" IsVisible="False" IsIndeterminate="True" Height="4" />
        <TextBlock x:Name="DestinationOutcomeText" Foreground="{DynamicResource BoughBrushTextMuted}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Click="CancelClicked" Height="32" MinWidth="80" Padding="12,4" />
      <Button x:Name="StartButton" Click="StartClicked" IsDefault="True" Classes="primary" Height="32" MinWidth="80" Padding="12,4"
              Background="{DynamicResource BoughBrushAccent}"
              Foreground="{DynamicResource BoughBrushAccentText}" />
    </StackPanel>
  </Grid>
</Window>
