<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:git="using:Bough.Core.Git"
        x:Class="Bough.App.Views.LargeFileStageWindow"
        Width="620" Height="440" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BoughBrushCanvas}">
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccentText}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BoughBrushSelection}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" RowSpacing="12">
    <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushText}" TextWrapping="Wrap" />
    <TextBlock x:Name="Description" Grid.Row="1" Foreground="{DynamicResource BoughBrushTextMuted}" TextWrapping="Wrap" />
    <ListBox x:Name="FilesList" Grid.Row="2" Background="{DynamicResource BoughBrushInset}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="1">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="git:GitLargeFileCandidate">
          <StackPanel Margin="10,6" Spacing="3">
            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushText}" ToolTip.Tip="{Binding Path}" />
            <TextBlock Text="{Binding DisplaySize}" Foreground="{DynamicResource BoughBrushWarning}" FontSize="11" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Click="CancelClicked" IsCancel="True" />
      <Button x:Name="ContinueButton" Click="ContinueClicked" Classes="primary" />
    </StackPanel>
  </Grid>
</Window>
