<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bough.App.ViewModels"
             x:Class="Bough.App.Views.AppUpdateView"
             x:DataType="vm:AppUpdateViewModel">
  <StackPanel Spacing="8">
    <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushText}" />
    <TextBlock x:Name="Description" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushTextSubtle}" />
    <Border Background="{DynamicResource BoughBrushInset}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
      <TextBlock x:Name="CurrentVersionLabel" Foreground="{DynamicResource BoughBrushText}" />
      <SelectableTextBlock x:Name="CurrentVersionValue" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushText}" />
      <TextBlock x:Name="LatestVersionLabel" Grid.Row="1" Foreground="{DynamicResource BoughBrushText}" />
      <SelectableTextBlock x:Name="LatestVersionValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushText}" />
    </Grid>
    </Border>
    <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushTextMuted}" />
    <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushError}" />
    <WrapPanel IsVisible="{Binding IsBusy}" HorizontalAlignment="Left">
      <TextBlock x:Name="DownloadText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushTextMuted}"
                 IsVisible="{Binding IsDownloading}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button x:Name="CancelButton" MinHeight="32" MinWidth="80" CornerRadius="6" IsVisible="{Binding CanCancel}" Click="CancelClicked" />
    </WrapPanel>
    <WrapPanel>
      <Button x:Name="CheckButton" MinHeight="32" MinWidth="80" CornerRadius="6" Margin="0,0,8,8" IsEnabled="{Binding CanCheck}" Click="CheckClicked" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,8">
        <Button x:Name="UpdateButton" Classes="primary" MinHeight="32" MinWidth="80" CornerRadius="6" IsEnabled="{Binding CanUpdate}" Click="UpdateClicked" />
        <Button x:Name="ReleaseButton" MinHeight="32" MinWidth="32" CornerRadius="6" Padding="7" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ReleaseClicked">
          <PathIcon Data="{StaticResource BoughIconGitHub}" Classes="boughIcon" />
        </Button>
      </StackPanel>
    </WrapPanel>
  </StackPanel>
</UserControl>
