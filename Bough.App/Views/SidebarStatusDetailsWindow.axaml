<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Bough.App.Views.SidebarStatusDetailsWindow"
        Width="900" Height="560" MinWidth="560" MinHeight="320"
        CanResize="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BoughBrushCanvas}">
  <Grid RowDefinitions="*,Auto,Auto" RowSpacing="12" Margin="12">
    <TextBox x:Name="StatusMessageTextBox" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="Wrap" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="14"
             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Background="{DynamicResource BoughBrushInset}" Foreground="{DynamicResource BoughBrushText}"
             BorderBrush="{DynamicResource BoughBrushBorder}" />
    <TextBlock x:Name="CopyFailureText" Grid.Row="1" IsVisible="False" TextWrapping="Wrap"
               Foreground="{DynamicResource BoughBrushError}" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CopyButton" Click="CopyClicked" MinHeight="32" MinWidth="80" Padding="12,4" />
      <Button x:Name="CloseButton" Classes="primary" Click="CloseClicked" IsCancel="True" IsDefault="True"
              MinHeight="32" MinWidth="80" Padding="12,4" />
    </StackPanel>
  </Grid>
</Window>
