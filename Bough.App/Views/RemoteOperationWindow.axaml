<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bough.App.ViewModels"
        x:Class="Bough.App.Views.RemoteOperationWindow"
        x:DataType="vm:RemoteOperationsViewModel"
        Width="560" Height="300" MinWidth="420" MinHeight="240"
        CanResize="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BoughBrushCanvas}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Margin="12">
    <StackPanel Grid.Row="0" Spacing="8">
      <TextBlock x:Name="OperationNameText" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushText}" />
      <TextBlock x:Name="TargetText" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushTextMuted}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="5">
      <TextBlock x:Name="OutcomeText" Text="{Binding OperationOutcomeText}" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushAccent}" />
      <TextBlock x:Name="QueueStatusText" Foreground="{DynamicResource BoughBrushTextMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />
      <StackPanel Spacing="5" IsVisible="{Binding IsBusy}">
        <TextBlock Text="{Binding OperationStageText}" Foreground="{DynamicResource BoughBrushText}" />
        <TextBlock x:Name="TransferStatusBlock" Text="{Binding TransferStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushTextMuted}" FontSize="12" />
        <ProgressBar IsIndeterminate="True" Height="4" />
        <TextBlock x:Name="ElapsedText" Foreground="{DynamicResource BoughBrushTextSubtle}" FontSize="12" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <TextBlock x:Name="ResultText" Text="{Binding StatusText}" TextWrapping="Wrap"
                   Foreground="{DynamicResource BoughBrushText}" />
        <Expander x:Name="DetailsExpander" IsExpanded="False" IsVisible="{Binding HasOperationDiagnostic}" HorizontalAlignment="Stretch">
          <TextBox Text="{Binding OperationDetailsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                   FontFamily="Cascadia Mono, Menlo, monospace" FontSize="12"
                   TextWrapping="Wrap" MaxHeight="140" Background="{DynamicResource BoughBrushCanvas}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Foreground="{DynamicResource BoughBrushText}" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="StopButton" Click="StopClicked" Height="32" MinWidth="80" Padding="12,4"
              IsVisible="True" IsEnabled="True"
              />
      <Button x:Name="CloseButton" Click="CloseClicked" Height="32" MinWidth="80" Padding="12,4"
              IsVisible="False" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
