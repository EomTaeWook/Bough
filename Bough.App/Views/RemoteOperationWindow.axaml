<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bough.App.ViewModels"
        x:Class="Bough.App.Views.RemoteOperationWindow"
        x:DataType="vm:RemoteOperationsViewModel"
        Width="560" Height="360" MinWidth="420" MinHeight="270"
        CanResize="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BoughBrushCanvas}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Margin="20">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock x:Name="OperationNameText" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushText}" />
      <TextBlock x:Name="TargetText" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushTextMuted}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="5">
      <TextBlock x:Name="OutcomeText" Text="{Binding OperationOutcomeText}" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushAccent}" />
      <TextBlock x:Name="QueueStatusText" Foreground="{DynamicResource BoughBrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding OperationStageText}" Foreground="{DynamicResource BoughBrushText}" />
      <TextBlock x:Name="TransferStatusBlock" Text="{Binding TransferStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushTextMuted}" FontSize="11" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
      <TextBlock x:Name="ElapsedText" Foreground="{DynamicResource BoughBrushTextSubtle}" FontSize="11" />
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <TextBlock x:Name="ResultText" Text="{Binding StatusText}" TextWrapping="Wrap"
                   Foreground="{DynamicResource BoughBrushText}" />
        <Border IsVisible="{Binding HasPullSummary}" BorderBrush="{DynamicResource BoughBrushBorder}" BorderThickness="1" Padding="10">
          <StackPanel Spacing="5">
            <TextBlock x:Name="PullSummaryHeading" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushAccent}" />
            <TextBlock x:Name="PullSummaryBlock" Text="{Binding PullSummaryText}" TextWrapping="Wrap" Foreground="{DynamicResource BoughBrushText}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="StopButton" Click="StopClicked" Padding="12,5"
              IsVisible="True" IsEnabled="True"
              />
      <Button x:Name="CloseButton" Click="CloseClicked" Padding="12,5"
              IsVisible="False" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
