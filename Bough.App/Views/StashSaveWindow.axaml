<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bough.App.ViewModels"
        x:Class="Bough.App.Views.StashSaveWindow"
        x:DataType="vm:StashViewModel"
        Title="{Binding SaveHeadingText}" Width="520" Height="420" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BoughBrushCanvas}">
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource BoughBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BoughBrushAccentText}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="20" RowSpacing="12">
    <TextBlock Text="{Binding SaveHeadingText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BoughBrushText}" />
    <StackPanel Grid.Row="1" Spacing="5">
      <TextBlock Text="{Binding MessageLabelText}" Foreground="{DynamicResource BoughBrushTextMuted}" />
      <TextBox x:Name="MessageInput" Text="{Binding StashMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <CheckBox Grid.Row="2" Content="{Binding IncludeUntrackedText}" IsChecked="{Binding IncludeUntracked, Mode=TwoWay}" Foreground="{DynamicResource BoughBrushText}" />
    <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="6">
      <TextBlock Text="{Binding TargetSummaryText}" Foreground="{DynamicResource BoughBrushTextMuted}" TextWrapping="Wrap" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BoughBrushInset}" Padding="10">
        <ItemsControl ItemsSource="{Binding StashTargets}" />
      </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="4" Text="{Binding ErrorText}" Foreground="{DynamicResource BoughBrushError}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{Binding CancelDropText}" Click="CancelClicked" />
      <Button Content="{Binding SaveButtonText}" Click="SaveClicked" IsEnabled="{Binding CanSaveStash}" Classes="primary" />
    </StackPanel>
  </Grid>
</Window>
